---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ProtegeDatosLocal — Diagnóstico y Cumplimiento Ley N° 21.719 de Protección de Datos Personales",
  description = "Plataforma técnica para evaluar, gestionar evidencia y priorizar la adecuación de municipalidades y gobiernos locales chilenos a la Ley N° 21.719 de Protección de Datos Personales."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans antialiased selection:bg-blue-800 selection:text-white">
    <!-- Skip to main content for WCAG A11y -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-800 focus:text-white focus:rounded-lg">
      Saltar al contenido principal
    </a>

    <!-- Top Navbar (Executive Slate Design) -->
    <header class="bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-0 z-40 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <span class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-bold text-lg shadow-sm group-hover:bg-blue-800 transition">
            🛡️
          </span>
          <div>
            <span class="font-extrabold tracking-tight text-slate-950 block leading-tight text-base">
              ProtegeDatos<span class="text-blue-700">Local</span>
            </span>
            <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block">
              Ley N° 21.719 · Protección de Datos Municipales
            </span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-7 text-xs font-semibold text-slate-600">
          <a href="/" class="hover:text-blue-800 transition">Inicio</a>
          <a href="/diagnostico" class="hover:text-blue-800 transition">Diagnóstico & Gestión</a>
          <a href="/filtro" class="hover:text-blue-800 transition font-semibold text-slate-700 hover:text-blue-800">⚡ Filtro Preventivo SaaS</a>
          <a href="/kits" class="hover:text-blue-800 transition font-bold text-blue-800 bg-blue-50 px-3 py-1.5 rounded-lg border border-blue-100">
            📦 Kits & Plantillas
          </a>
          <a href="/normativa" class="hover:text-blue-800 transition">Base Normativa BCN</a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="mailto:evega.ap@gmail.com?subject=[ProtegeDatosLocal]%20Consulta%20Acompa%C3%B1amiento%20Municipal"
            class="hidden sm:inline-flex px-3.5 py-2 border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-xl transition"
          >
            ✉️ Contactar Consultor
          </a>
          <a
            href="/diagnostico"
            class="px-4 py-2 bg-slate-900 hover:bg-blue-800 text-white text-xs font-bold rounded-xl shadow-xs transition"
          >
            Iniciar Diagnóstico →
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Institutional Footer (Executive Charcoal) -->
    <footer class="bg-slate-950 text-slate-400 py-14 border-t border-slate-850 text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2">
          <div class="flex items-center gap-2 text-white font-extrabold text-base mb-2">
            <span>🛡️</span> ProtegeDatosLocal
          </div>
          <p class="text-slate-400 text-xs leading-relaxed max-w-md mb-4">
            Plataforma técnica especializada de autodiagnóstico, trazabilidad de evidencia y priorización progresiva para apoyar la preparación institucional de las municipalidades chilenas frente a la <strong>Ley N° 21.719 de Protección de Datos Personales</strong>.
          </p>
          <div class="text-[11px] text-slate-400 p-3.5 bg-slate-900 rounded-xl border border-slate-800 max-w-md leading-relaxed">
            <strong>Aclaración Institucional:</strong> ProtegeDatosLocal es una herramienta técnica de apoyo a la gestión municipal. Sus resultados no constituyen certificación de cumplimiento legal ni sustituyen la asesoría jurídica especializada.
          </div>
        </div>

        <div>
          <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-3">Marco Legal Principal</h4>
          <ul class="space-y-1.5 text-slate-400 text-xs">
            <li>• <a href="/normativa" class="hover:text-white transition">Ley N° 21.719 (Protección de Datos)</a></li>
            <li>• <a href="/normativa" class="hover:text-white transition">Ley N° 21.663 (Ciberseguridad ANCI)</a></li>
            <li>• <a href="/normativa" class="hover:text-white transition">Ley N° 18.695 (Orgánica de Municipalidades)</a></li>
            <li>• <a href="/normativa" class="hover:text-white transition">Ley N° 20.584 (Ficha Clínica y Salud)</a></li>
            <li>• <a href="/normativa" class="hover:text-white transition">Ley N° 20.379 (Registro Social de Hogares)</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-3">Dirección & Coordinación</h4>
          <p class="text-slate-300 text-xs mb-1 font-semibold">
            Eduardo Vega Toledo
          </p>
          <p class="text-slate-400 text-[11px] mb-3">
            Consultoría en Gestión Pública, Protección de Datos y Modernización del Estado.
          </p>
          <a href="mailto:evega.ap@gmail.com" class="text-blue-400 hover:underline font-semibold block text-xs mb-2">
            ✉️ evega.ap@gmail.com
          </a>
          <a href="https://www.linkedin.com/in/evegat1989/" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline font-semibold block text-xs mb-4">
            🔗 LinkedIn Profesional ↗
          </a>
          <div class="text-[11px] text-slate-400 pt-2 border-t border-slate-900">
            © 2025–2026 Eduardo Vega Toledo. Todos los derechos reservados.
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
