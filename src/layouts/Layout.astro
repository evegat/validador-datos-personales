---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title = "ProtegeDatosLocal — Ley N° 21.719 para Gobiernos Locales en Chile", 
  description = "Plataforma integral de diagnóstico de madurez, filtro preventivo SaaS (EIPD), generador de kits legales y matriz RAT para municipalidades de Chile.",
  image = "/og-preview.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://aliceblue-dogfish-345779.hostingersite.com');
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="keywords" content="Ley 21719, Proteccion de Datos Personales Chile, Municipalidades Chile, Compliance Municipal, DPO Municipal, Evaluacion de Impacto EIPD, Matriz RAT, Eduardo Vega Toledo, Gobiernos Locales Chile" />
    <meta name="author" content="Eduardo Vega Toledo" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f172a" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:site_name" content="ProtegeDatosLocal" />
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Schema.org JSON-LD (Estructura de Datos Abierta) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "ProtegeDatosLocal",
        "operatingSystem": "Web",
        "applicationCategory": "GovernmentApplication",
        "description": "Plataforma de diagnóstico de madurez institucional, filtro preventivo de privacidad y kits de adecuación a la Ley N° 21.719 para municipalidades de Chile.",
        "url": "https://aliceblue-dogfish-345779.hostingersite.com",
        "author": {
          "@type": "Person",
          "name": "Eduardo Vega Toledo",
          "email": "evega.ap@gmail.com",
          "jobTitle": "Consultor en Gestión Pública y Protección de Datos",
          "sameAs": "https://www.linkedin.com/in/evegat1989/"
        }
      }
    </script>

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800;900&display=swap" rel="stylesheet" />

    <!-- ARQUITECTURA ZERO-THIRD-PARTY / CERO RASTREADORES EXTERNOS -->
    <!-- Esta aplicación procesa el 100% de los diagnósticos de forma local en el navegador del usuario (Client-Side). -->
    <!-- Ningún dato personal, respuesta institucional ni métrica se transfiere a servidores de terceros. -->
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col selection:bg-blue-800 selection:text-white">
    <!-- Header / Navbar -->
    <header class="sticky top-0 z-40 bg-slate-950/95 backdrop-blur-md border-b border-slate-800 text-white transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <!-- Logo & Brand -->
        <a href="/" class="flex items-center gap-2.5 group cursor-pointer shrink-0">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-700 to-slate-900 flex items-center justify-center text-white text-lg font-black shadow-sm group-hover:scale-105 transition-transform">
            🛡️
          </div>
          <div>
            <div class="text-sm font-black tracking-tight text-white flex items-center gap-1.5">
              <span>ProtegeDatosLocal</span>
              <span class="text-[9px] font-bold uppercase bg-blue-500/20 text-blue-300 border border-blue-400/30 px-1.5 py-0.2 rounded">GovTech</span>
            </div>
            <div class="text-[10px] text-slate-400 font-medium">Ley N° 21.719 · Gobiernos Locales</div>
          </div>
        </a>

        <!-- Main Navigation Links -->
        <nav class="hidden lg:flex items-center gap-1 text-xs font-semibold text-slate-300">
          <a href="/diagnostico" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800 transition">
            Diagnóstico (IMM)
          </a>
          <a href="/filtro" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800 transition flex items-center gap-1">
            <span>Filtro SaaS (EIPD)</span>
            <span class="text-[9px] bg-emerald-500/20 text-emerald-300 px-1 rounded font-bold">Nuevo</span>
          </a>
          <a href="/kits" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800 transition">
            Generador de Kits
          </a>
          <a href="/rat" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800 transition">
            Matriz RAT
          </a>
          <a href="/guia" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800 transition">
            Guía Ley 21.719
          </a>
          <a href="/normativa" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800 transition">
            Normativa BCN
          </a>
          <a href="/transparencia-algoritmica" class="px-3 py-1.5 rounded-lg hover:text-white hover:bg-slate-800 transition text-slate-400 hover:text-blue-300">
            Transparencia Algorítmica
          </a>
        </nav>

        <!-- Right Action Button -->
        <div class="flex items-center gap-2.5">
          <a
            href="/diagnostico"
            class="px-4 py-2 bg-blue-800 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-xs transition cursor-pointer"
          >
            Iniciar Diagnóstico →
          </a>
        </div>
      </div>
    </header>

    <!-- Subnav for Mobile -->
    <div class="lg:hidden bg-slate-900 border-b border-slate-800 px-4 py-2 flex items-center gap-2 overflow-x-auto text-xs text-slate-300">
      <a href="/diagnostico" class="whitespace-nowrap px-2.5 py-1 rounded bg-slate-800 text-white font-medium">Diagnóstico</a>
      <a href="/filtro" class="whitespace-nowrap px-2.5 py-1 rounded hover:bg-slate-800">Filtro SaaS</a>
      <a href="/kits" class="whitespace-nowrap px-2.5 py-1 rounded hover:bg-slate-800">Generador Kits</a>
      <a href="/rat" class="whitespace-nowrap px-2.5 py-1 rounded hover:bg-slate-800">Matriz RAT</a>
      <a href="/guia" class="whitespace-nowrap px-2.5 py-1 rounded hover:bg-slate-800">Guía 21.719</a>
      <a href="/normativa" class="whitespace-nowrap px-2.5 py-1 rounded hover:bg-slate-800">Normativa</a>
      <a href="/transparencia-algoritmica" class="whitespace-nowrap px-2.5 py-1 rounded hover:bg-slate-800 text-blue-300">Transparencia Algorítmica</a>
    </div>

    <!-- Main Content Slot -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Institutional Footer -->
    <footer class="bg-slate-950 text-slate-400 border-t border-slate-800 py-12 text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 pb-8 border-b border-slate-850">
          <div class="md:col-span-2">
            <div class="flex items-center gap-2 text-white font-black text-base mb-2">
              <span>🛡️ ProtegeDatosLocal</span>
            </div>
            <p class="text-slate-400 text-xs leading-relaxed max-w-md mb-4">
              Plataforma de gobernanza, diagnóstico de madurez institucional y filtro preventivo de privacidad para gobiernos locales frente a la Ley N° 21.719 y Ley N° 21.663.
            </p>
            <div class="text-[11px] text-slate-400 bg-slate-900/80 p-3 rounded-xl border border-slate-800 max-w-md space-y-1">
              <div><strong>Arquitectura Soberana:</strong> Procesamiento local 100% en el navegador (Zero-Storage).</div>
              <div><strong>Aclaración:</strong> Instrumento de apoyo a la gestión. No constituye certificación legal.</div>
            </div>
          </div>

          <div>
            <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-3">Módulos de la Plataforma</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/diagnostico" class="hover:text-white transition">Autodiagnóstico IMM (7 Ejes)</a></li>
              <li><a href="/filtro" class="hover:text-white transition">Filtro Preventivo SaaS (EIPD)</a></li>
              <li><a href="/kits" class="hover:text-white transition">Generador de Decretos y DPAs</a></li>
              <li><a href="/rat" class="hover:text-white transition">Inventario de Tratamientos (RAT)</a></li>
              <li><a href="/guia" class="hover:text-white transition">Guía Estratégica Ley 21.719</a></li>
              <li><a href="/normativa" class="hover:text-white transition">Fuentes Oficiales BCN</a></li>
              <li><a href="/transparencia-algoritmica" class="hover:text-white transition text-blue-400">Transparencia Algorítmica (Res. 372 CPLT)</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-3">Acompañamiento Técnico</h4>
            <p class="text-xs text-slate-400 leading-relaxed mb-3">
              Servicios de consultoría y puesta al día acelerada disponibles para municipalidades en todo Chile:
            </p>
            <div class="text-xs space-y-1">
              <div class="text-white font-semibold">Eduardo Vega Toledo</div>
              <div class="text-slate-400">Consultor en Gestión Pública & Privacidad</div>
              <div>
                <a href="mailto:evega.ap@gmail.com" class="text-blue-400 hover:underline">evega.ap@gmail.com</a>
              </div>
              <div>
                <a href="https://www.linkedin.com/in/evegat1989/" target="_blank" rel="noopener" class="text-blue-400 hover:underline">LinkedIn Oficial ↗</a>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 text-[11px] text-slate-400">
          <div>
            © {new Date().getFullYear()} ProtegeDatosLocal · Desarrollado por Eduardo Vega Toledo. Todos los derechos reservados.
          </div>
          <div class="flex gap-4">
            <span>Fecha de corte normativo: <strong>agosto de 2026</strong></span>
            <span>Vigencia Ley 21.719: <strong>1 de diciembre de 2026</strong></span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
