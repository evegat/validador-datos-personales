---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title = "ProtegeDatosLocal — Privacidad y Ley N° 21.719 para Municipios", 
  description = "Diagnóstico, filtro preventivo y decretos oficiales para la Ley N° 21.719 en municipios de Chile."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://aliceblue-dogfish-345779.hostingersite.com');
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Inline script to prevent theme flash -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 min-h-screen flex flex-col antialiased transition-colors duration-200">
    <!-- Header -->
    <header class="sticky top-0 z-40 bg-white/90 dark:bg-slate-950/90 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-blue-600 dark:bg-blue-500 text-white flex items-center justify-center font-bold text-sm shadow-xs group-hover:scale-105 transition">
            🛡️
          </div>
          <span class="font-extrabold text-slate-950 dark:text-white tracking-tight text-sm sm:text-base">
            ProtegeDatos<span class="text-blue-600 dark:text-blue-400">Local</span>
          </span>
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-slate-600 dark:text-slate-300">
          <a href="/diagnostico" class="hover:text-blue-600 dark:hover:text-blue-400 transition">Diagnóstico</a>
          <a href="/filtro" class="hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center gap-1">
            <span>Filtro SaaS</span>
            <span class="text-[9px] font-bold bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-300 px-1.5 py-0.5 rounded-full border border-blue-200 dark:border-blue-800">EIPD</span>
          </a>
          <a href="/kits" class="hover:text-blue-600 dark:hover:text-blue-400 transition">Generador</a>
          <a href="/rat" class="hover:text-blue-600 dark:hover:text-blue-400 transition">Matriz RAT</a>
          <a href="/guia" class="hover:text-blue-600 dark:hover:text-blue-400 transition">Guía Ley</a>
        </nav>

        <!-- Right Side: Dark Mode Toggle & Action Button -->
        <div class="flex items-center gap-3">
          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Cambiar tema claro / oscuro"
            class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 flex items-center justify-center text-sm transition cursor-pointer"
          >
            <span class="dark:hidden">🌙</span>
            <span class="hidden dark:inline">☀️</span>
          </button>

          <!-- Start Button -->
          <a
            href="/diagnostico"
            class="px-4 py-2 bg-slate-950 dark:bg-blue-600 hover:bg-blue-600 dark:hover:bg-blue-500 text-white text-xs font-bold rounded-xl transition shadow-xs"
          >
            Diagnóstico →
          </a>
        </div>
      </div>
    </header>

    <!-- Mobile Subnav -->
    <div class="md:hidden bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-4 py-2 flex items-center gap-2 overflow-x-auto text-xs text-slate-600 dark:text-slate-300">
      <a href="/diagnostico" class="whitespace-nowrap px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 font-bold text-slate-900 dark:text-white">Diagnóstico</a>
      <a href="/filtro" class="whitespace-nowrap px-3 py-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Filtro SaaS</a>
      <a href="/kits" class="whitespace-nowrap px-3 py-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Generador</a>
      <a href="/rat" class="whitespace-nowrap px-3 py-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Matriz RAT</a>
      <a href="/guia" class="whitespace-nowrap px-3 py-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Guía</a>
    </div>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white dark:bg-slate-950 border-t border-slate-200/80 dark:border-slate-800/80 py-10 text-xs text-slate-500 dark:text-slate-400 transition-colors">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <div>
          <span class="font-bold text-slate-900 dark:text-white">ProtegeDatosLocal</span> · Plataforma GovTech de Privacidad Municipal.
          <div class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">Desarrollado por Eduardo Vega Toledo · <a href="mailto:evega.ap@gmail.com" class="text-blue-600 dark:text-blue-400 hover:underline">evega.ap@gmail.com</a></div>
        </div>
        <div class="flex gap-4 text-[11px] font-medium">
          <a href="/transparencia-algoritmica" class="hover:text-slate-900 dark:hover:text-white transition">Transparencia Algorítmica</a>
          <a href="/normativa" class="hover:text-slate-900 dark:hover:text-white transition">Normativa BCN</a>
        </div>
      </div>
    </footer>

    <!-- Theme Toggle Handler Script -->
    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }
    </script>
  </body>
</html>
