---
import Layout from '../layouts/Layout.astro';
import { OFFICIAL_LEGAL_SOURCES } from '../data/legalSources';
---

<Layout
  title="Base Normativa Oficial | Validador MuniTech"
  description="Marco jurídico, normas oficiales y fundamentos legales de la preparación municipal frente a la Ley N° 21.719 y Ley N° 21.663."
>
  <section class="max-w-5xl mx-auto py-12 px-4 sm:px-6">
    <div class="border-b border-slate-200 pb-6 mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-800 border border-blue-200 mb-3">
        ⚖️ Trazabilidad Jurídica Oficial
      </div>
      <h1 class="text-3xl font-extrabold text-slate-950">
        Base Normativa Oficial Aplicable
      </h1>
      <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
        Cada criterio identifica su fundamento, distingue obligaciones legales de recomendaciones y enlaza las fuentes oficiales utilizadas en su revisión.
      </p>
      <div class="mt-3 text-xs text-slate-500 bg-slate-100 p-3 rounded-xl border border-slate-200">
        <strong>Última revisión normativa:</strong> agosto de 2026. Ante cambios legales, reglamentarios o instrucciones de las autoridades competentes, prevalecerá siempre la fuente oficial vigente.
      </div>
    </div>

    <div class="space-y-6">
      {OFFICIAL_LEGAL_SOURCES.map((src) => (
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs hover:border-slate-400 transition">
          <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
            <div>
              <span class="px-2.5 py-0.5 bg-blue-100 text-blue-900 text-xs font-bold rounded-md">
                {src.norma} • {src.tipoFundamento}
              </span>
              <h2 class="text-base font-bold text-slate-950 mt-1.5">
                {src.tituloOficial}
              </h2>
            </div>
            <a
              href={src.bcnUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-blue-800 text-xs font-bold rounded-lg border border-slate-300 transition inline-flex items-center gap-1 shrink-0"
            >
              <span>Ver en Fuente Oficial (BCN / ChileCompra)</span>
              <span>↗</span>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-600 bg-slate-50 p-3.5 rounded-xl border border-slate-200 mb-3">
            <div><strong>Autoridad / Órgano Competente:</strong> {src.autoridadEspecializada}</div>
            <div><strong>Vigencia / Estado:</strong> {src.vigencia} (Verificado: {src.fechaVerificacion})</div>
          </div>

          <p class="text-xs text-slate-700 leading-relaxed mb-2">
            <strong>Aplicación en el Ámbito Municipal:</strong> {src.resumenAplicacionMunicipal}
          </p>

          <div class="text-[11px] text-slate-500 bg-white p-2.5 rounded-lg border border-slate-200">
            <strong>Nota de interpretación:</strong> {src.observaciones}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
